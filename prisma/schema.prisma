// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id             String         @id @default(cuid())
  name           String         @unique
  password       String
  firstName      String?        @map(name: "first_name")
  lastName       String?        @map(name: "last_name")
  age            String?
  grade          String?
  profileImage   String?
  profileUpdated Boolean        @default(false)
  createdAt      DateTime       @default(now()) @map(name: "created_at")
  updatedAt      DateTime       @updatedAt @map(name: "updated_at")
  cardNumber     String?        @map(name: "card_number")
  cardName       String?        @map(name: "card_name")
  expireMonth    String?        @map(name: "expire_month")
  expireYear     String?        @map(name: "expire_year")
  cardCVC        String?        @map(name: "card_cvc")
  spellingLists  SpellingList[] // Relation to SpellingList

  @@map(name: "users")
}

model SpellingList {
  id            Int            @id @default(autoincrement())
  listName      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String 
  user          User           @relation(fields: [userId], references: [id])
  words         Word[]
  groupedWords  GroupedWord[]
  syllableWords SyllableWord[] // Relation to SyllableWord
  progress      Float          @default(0) // Field to store progress percentage

  @@map(name: "spelling_list")
}

model Word {
  id              Int          @id @default(autoincrement())
  listId          Int
  word            String
  difficultyLevel String       @default("medium")
  type            String       @default("original") // original, syllabus, or grouped
  spellingList    SpellingList @relation(fields: [listId], references: [id])
  studied         Boolean      @default(false) // Field to track if the word is studied

  @@map(name: "words")
}

model GroupedWord {
  id           Int          @id @default(autoincrement())
  listId       Int
  groupName    String
  word         String
  studied    Boolean      @default(false) // Field to track if the grouped word is studied
  spellingList SpellingList @relation(fields: [listId], references: [id])

  @@map(name: "grouped_words")
}

model SyllableWord {
  id           Int          @id @default(autoincrement())
  listId       Int
  word         String
  options      Json         
  answer       String
  studied      Boolean      @default(false) // Field to track if the syllable word is studied     
  spellingList SpellingList @relation(fields: [listId], references: [id])

  @@map(name: "syllable_words")
}
