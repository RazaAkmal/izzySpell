# Example environment for IzzySpell - copy to .env and fill in real values.
# Never commit real values.

# Database (Neon / Vercel Postgres)
PRISMA_URL=
PRISMA_DIRECT_URL=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Public site URL (used for links that leave the app, e.g. password reset emails)
NEXT_PUBLIC_BASE_URL=
# Optional override for those links; set to http://localhost:3000 for local development
SITE_URL=

# Password reset email (Resend REST API)
RESEND_API_KEY=
# e.g. IzzySpell <no-reply@your-verified-domain.com>
EMAIL_FROM=

# Shown on the Forgot Password page for accounts without a parent email
NEXT_PUBLIC_SUPPORT_EMAIL=

# Other services already used by the app
OPENAI_API_KEY=
# Optional: chat model for list processing, flash cards, scramble words and timer suggestions (defaults to gpt-4.1)
OPENAI_MODEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
